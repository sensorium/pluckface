@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix pset:   <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .

<urn:sensorium:pluckface>
	a lv2:Plugin ;
	lv2:binary <pluckface.so>  ;
	rdfs:seeAlso 	<pluckface.ttl> .

<presets/envelope.ttl>
	a pset:Preset ;
	rdfs:seeAlso <presets/envelope.ttl> .

<presets/responsive_autorange.ttl>
	a pset:Preset ;
	rdfs:seeAlso <presets/responsive_autorange.ttl> .

<presets/sensitive_fast_autorange.ttl>
	a pset:Preset ;
	rdfs:seeAlso <presets/sensitive_fast_autorange.ttl> .

<presets/slow_autorange.ttl>
	a pset:Preset ;
	rdfs:seeAlso <presets/slow_autorange.ttl> .
@prefix modgui: <http://moddevices.com/ns/modgui#> .
@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .

<urn:sensorium:pluckface>
    modgui:gui [
        modgui:resourcesDirectory <modgui> ;
        modgui:iconTemplate <modgui/icon-pluckface.html> ;
        modgui:stylesheet <modgui/stylesheet-pluckface.css> ;
        modgui:javascript <modgui/pluckface.js> ;
        modgui:screenshot <modgui/screenshot-pluckface.png> ;
        modgui:thumbnail <modgui/thumbnail-pluckface.png> ;
        modgui:monitoredOutputs [
            lv2:symbol "input_level_db" ;
        ] , [
            lv2:symbol "cv_out_meter" ;
        ] , [
            lv2:symbol "onset_indicator" ;
        ] , [
            lv2:symbol "auto_scale_out" ;
        ] , [
            lv2:symbol "auto_offset_out" ;
        ]
    ] .